{
  "apiVersion": "authentik.weebo.io/v1alpha1",
  "kind": "AuthentikNamespacePolicy",
  "scope": "Cluster",
  "description": "Namespace allow-list enforced by the admission webhook (and\ndouble-checked by reconcilers). Cluster-scoped. Default-deny: a\n`(namespace, kind)` pair is only allowed if some rule across every\n`AuthentikNamespacePolicy` explicitly allows it — see\n`domain::allow_list::evaluate`, which this CRD's rules map directly\nonto.",
  "properties": {
    "rules": {
      "items": {
        "properties": {
          "allowedKinds": {
            "items": {
              "enum": [
                "AuthentikApplication",
                "AuthentikAccessPolicy"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "effect": {
            "enum": [
              "Allow",
              "Deny"
            ],
            "type": "string"
          },
          "namespaces": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "allowedKinds",
          "effect",
          "namespaces"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rules"
  ],
  "type": "object"
}

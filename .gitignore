# Rust
/target
**/target

# Node / Fumadocs docs site (see .prompt/plan.md, "Documentation")
# Note: docs/content/crds/*.mdx and docs/public/crd-schemas/*.json are
# generated but deliberately versioned (checked by CI's "regen-and-diff"),
# so they are NOT ignored here.
node_modules/
.next/

# Editors / OS
.idea/
*.swp
.DS_Store

# Local env / secrets
.env
.env.*

# desloppify local state (per-machine, not shared)
.desloppify/

# The kit's library chart, fetched by `task helm:deps` (Chart.lock pins it)
deploy/charts/*/charts/

# Task's own cache (remote includes, checksums); the operator's task files
# live in .tasks/
.task/

{
  "kinds": {
    "AuthentikAccessPolicy": {
      "produces": [],
      "references": [
        {
          "path": "spec.applicationRef",
          "to": [
            {
              "group": "authentik.weebo.io",
              "kind": "AuthentikApplication"
            }
          ]
        }
      ]
    },
    "AuthentikApplication": {
      "produces": [
        {
          "each": "spec.provider.oauth2",
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "OidcIssuer"
          },
          "name": [
            "issuerUrl"
          ],
          "template": "{/spec.instanceRef>spec.url}/application/o/{/spec.slug}/"
        },
        {
          "each": "spec.provider.proxy.externalHost",
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "HttpEndpoint"
          },
          "name": [
            "."
          ]
        },
        {
          "each": "spec.secretTargets[]",
          "keyNames": [
            "AUTHENTIK_CLIENT_ID",
            "AUTHENTIK_CLIENT_SECRET",
            "AUTHENTIK_URL"
          ],
          "kind": {
            "group": "",
            "kind": "Secret"
          },
          "name": [
            "name"
          ],
          "namespace": "namespace",
          "unless": {
            "equals": "vault",
            "path": "backend"
          }
        }
      ],
      "references": [
        {
          "path": "spec.instanceRef",
          "to": [
            {
              "group": "authentik.weebo.io",
              "kind": "AuthentikInstance"
            },
            {
              "group": "authentik.weebo.io",
              "kind": "AuthentikLocalInstance"
            }
          ]
        },
        {
          "path": "spec.provider.proxy.outpostRef",
          "to": [
            {
              "group": "authentik.weebo.io",
              "kind": "AuthentikOutpost"
            }
          ]
        }
      ]
    },
    "AuthentikBrand": {
      "produces": [
        {
          "each": "spec.domain",
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "DnsName"
          },
          "name": [
            "."
          ]
        }
      ],
      "references": [
        {
          "path": "spec.defaultApplicationRef",
          "to": [
            {
              "group": "authentik.weebo.io",
              "kind": "AuthentikApplication"
            }
          ]
        }
      ]
    },
    "AuthentikFlow": {
      "produces": [],
      "references": []
    },
    "AuthentikGroup": {
      "produces": [],
      "references": []
    },
    "AuthentikInstance": {
      "produces": [
        {
          "each": "spec.secretStore.vault.address",
          "kind": {
            "group": "schematic.weebo.io",
            "kind": "VaultServer"
          },
          "name": [
            "."
          ]
        }
      ],
      "references": [
        {
          "path": "spec.secretStore.vault.caSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.tls.caSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.tokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        }
      ]
    },
    "AuthentikLocalInstance": {
      "produces": [],
      "references": [
        {
          "path": "spec.tls.caSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        },
        {
          "path": "spec.tokenSecretRef",
          "to": [
            {
              "group": "",
              "kind": "Secret"
            }
          ]
        }
      ]
    },
    "AuthentikNamespacePolicy": {
      "produces": [],
      "references": []
    },
    "AuthentikOutpost": {
      "produces": [],
      "references": []
    },
    "AuthentikScopeMapping": {
      "produces": [],
      "references": []
    },
    "AuthentikUser": {
      "produces": [],
      "references": []
    }
  },
  "schematic": {
    "Database": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "A database server the instance uses, outside its pods.",
        "properties": {
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "engine": {
            "description": "`postgres`, `mysql`, `sqlite`…",
            "nullable": true,
            "type": "string"
          },
          "host": {
            "description": "Where it listens (`db.example.com:5432`).",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Namespaced"
    },
    "DnsName": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "A DNS name the instance serves or uses (a domain, a host), named by\nthe name itself.",
        "properties": {
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "records": {
            "description": "The records it needs, published outside the cluster.",
            "items": {
              "description": "One DNS record of a name.",
              "properties": {
                "type": {
                  "description": "`A`, `CNAME`, `MX`, `TXT`…",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "zone": {
            "description": "The zone that holds it.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    },
    "HttpEndpoint": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "An HTTP service outside the cluster that the instance calls — a webhook\nreceiver, a scanner, a telemetry collector — named by its URL.",
        "properties": {
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "role": {
            "description": "What it is to the instance: `webhook`, `scanner`, `otlp`…",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    },
    "OidcIssuer": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "An OpenID Connect issuer, named by its URL (the `iss` its tokens carry).",
        "properties": {
          "audiences": {
            "description": "The audiences its tokens are minted for.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "discoveryUrl": {
            "description": "Where its discovery document is, when not\n`<issuer>/.well-known/openid-configuration`.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    },
    "S3Bucket": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "An S3-compatible bucket, named by the bucket.",
        "properties": {
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "endpoint": {
            "description": "The endpoint's URL; unset, the provider's default.",
            "nullable": true,
            "type": "string"
          },
          "region": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    },
    "UpstreamRegistry": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "A package or image registry outside the cluster that the instance\nmirrors or proxies, named by its URL.",
        "properties": {
          "authenticated": {
            "description": "Whether pulling from it needs credentials.",
            "type": "boolean"
          },
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          },
          "type": {
            "description": "Its format: `oci`, `npm`, `cargo`, `pypi`…",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    },
    "VaultServer": {
      "group": "schematic.weebo.io",
      "produces": [],
      "references": [],
      "schema": {
        "description": "A Vault server the instance writes secrets to, named by its address.",
        "properties": {
          "authMount": {
            "description": "The Kubernetes auth mount the instances log in with.",
            "nullable": true,
            "type": "string"
          },
          "description": {
            "description": "Free text, for the drawing.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "scope": "Cluster"
    }
  },
  "version": 1
}
